<style>.sp-test1234{--sp-test1234-fast:linear(0,.08,.24,.409,.558,.678,.77,.838,.887,.922,.947,.964,.976,.984,.989,.993,.995,.997,.998,.999,1);--sp-test1234-attention:cubic-bezier(.4,0,.2,1);--sp-test1234-repeat:linear}.sp-test1234,.sp-test1234 *,.sp-test1234 *::before,.sp-test1234 *::after{box-sizing:border-box;margin:0;padding:0;border:0;font:inherit;line-height:inherit;letter-spacing:normal;text-transform:none;text-decoration:none;list-style:none;background:none;color:inherit;max-width:none;min-width:0;float:none}.sp-test1234{--sp-test1234-bg:#ffffff14;--sp-test1234-bd:#ffffff29;--sp-test1234-tn:#ffffff99;--sp-test1234-tb:#ffffff;--sp-test1234-ic:#ffffff99;--sp-test1234-blur:12px;--sp-test1234-sh:rgba(255,255,255,.55);display:inline-flex;align-items:center;gap:6px;position:relative;vertical-align:middle;font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-size:13px;font-weight:400;font-style:normal;font-variant:normal;line-height:1.2;text-align:left;white-space:nowrap;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.sp-test1234__pill{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px 0 10px;border-radius:15px;background:var(--sp-test1234-bg);box-shadow:none;color:var(--sp-test1234-tb);white-space:nowrap;cursor:pointer;user-select:none;-webkit-tap-highlight-color:transparent;outline:none;-webkit-backdrop-filter:blur(var(--sp-test1234-blur));backdrop-filter:blur(var(--sp-test1234-blur));transition:transform .08s var(--sp-test1234-fast)}@keyframes sp-test1234-in{0%,100%{transform:none}20%,60%{transform:translateX(-3px)}40%,80%{transform:translateX(3px)}}@keyframes sp-test1234-rp{0%{transform:translateX(-110%)}18%,100%{transform:translateX(110%)}}.sp-test1234{animation:sp-test1234-in .48s var(--sp-test1234-attention) backwards}.sp-test1234__pill{position:relative;overflow:hidden}.sp-test1234__pill::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:linear-gradient(105