tion:relative;overflow:hidden}.sp-test1234__pill::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 70%);transform:translateX(110%);animation:sp-test1234-rp 5s var(--sp-test1234-repeat) 5s infinite}.sp-test1234__pill:hover{transform:scale(1.04)}.sp-test1234__pill:focus-visible{outline:2px solid var(--sp-test1234-tb);outline-offset:2px}.sp-test1234__av{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;overflow:hidden;background:#ff6b35;color:#000000;font-size:11px;font-weight:600;line-height:1}.sp-test1234__n{color:var(--sp-test1234-tn)}.sp-test1234__b{color:var(--sp-test1234-tb);font-weight:500}.sp-test1234__ic{flex:none;display:block;color:var(--sp-test1234-ic);transition:transform .08s var(--sp-test1234-fast)}.sp-test1234__pill:hover .sp-test1234__ic,.sp-test1234__pill:focus-visible .sp-test1234__ic{transform:translate(2px,-2px)}.sp-test1234__sos{position:absolute;left:100%;top:0;bottom:0;display:flex;align-items:center;gap:6px;padding-left:6px;pointer-events:none}.sp-test1234:hover .sp-test1234__sos,.sp-test1234:focus-within .sp-test1234__sos{pointer-events:auto}.sp-test1234__so{flex:none;display:grid;place-items:center;width:36px;height:36px;border-radius:18px;background:var(--sp-test1234-bg);box-shadow:0 1px 6px rgba(0,0,0,.08);color:var(--sp-test1234-ic);outline:none;-webkit-tap-highlight-color:transparent;opacity:0;transform:translateX(-6px) scale(.8);pointer-events:none;transition:transform .16s var(--sp-test1234-slow-exit),opacity .16s var(--sp-test1234-slow-exit)}.sp-test1234__so svg{display:block;width:16px;height:16px}.sp-test1234:hover .sp-test1234__so,.sp-test1234:focus-within .sp-test1234__so{opacity:1;transform:none;pointer-events:auto;transition:transform .24s var(--sp-test1234-slow) var(--d),opacity .24s var(--sp-test1234-slow) var(--d),box-shadow .08s var(--sp-test1234-fast)}.sp-test1234:hover 