.sp-test1234__so:hover{transform:scale(1.06);transition-delay:0s;box-shadow:0 2px 12px rgba(0,0,0,.12)}.sp-test1234__so:focus-visible{outline:2px solid var(--sp-test1234-tb);outline-offset:2px}@media (hover:none){.sp-test1234__so{opacity:1;transform:none;pointer-events:auto}.sp-test1234__sos{position:static;padding-left:0;pointer-events:auto}}@media (prefers-reduced-motion:reduce){.sp-test1234 .sp-test1234__so,.sp-test1234:hover .sp-test1234__so,.sp-test1234:hover .sp-test1234__so:hover{transform:none;transition-property:opacity;transition-delay:0s}}.sp-test1234__so{position:relative}.sp-test1234__so::before{content:"";position:absolute;inset:-4px}.sp-test1234__pill{position:relative;justify-content:center;width:112px;height:112px;padding:0;gap:0;border-radius:50%}.sp-test1234__av{width:49px;height:49px;border-radius:50%;font-size:18px}@keyframes sp-test1234-spin{to{transform:rotate(360deg)}}.sp-test1234__ring{position:absolute;inset:0;display:block;width:100%;height:100%;overflow:visible;pointer-events:none;animation:sp-test1234-spin 24s linear infinite}.sp-test1234__ring text{fill:var(--sp-test1234-tn);font-size:9.5px;font-weight:500}.sp-test1234__ring .sp-test1234__rb{fill:var(--sp-test1234-tb);font-weight:650}.sp-test1234__ring circle{fill:none;stroke:var(--sp-test1234-bd);stroke-width:1}@media (prefers-color-scheme:dark){.sp-test1234{--sp-test1234-bg:#14141c;--sp-test1234-bd:#2e2e3a;--sp-test1234-tn:#8a8a99;--sp-test1234-tb:#ffffff;--sp-test1234-ic:#8a8a99}}@media (prefers-reduced-motion:reduce){.sp-test1234__ic{transition:none}.sp-test1234,.sp-test1234 .sp-test1234__pill,.sp-test1234 .sp-test1234__pill:hover{animation:none;transform:none}.sp-test1234 .sp-test1234__pill::after{animation:none;opacity:0}.sp-test1234 .sp-test1234__ring{animation:none}.sp-test1234 .sp-test1234__pill:hover .sp-test1234__ic,.sp-test1234 .sp-test1234__pill:focus-visible .sp-test1234__ic{transform:none}}</style>
