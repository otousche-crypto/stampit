.sp-test1234__so:hover{transform:scale(1.06);transition-delay:0s;box-shadow:0 2px 12px rgba(0,0,0,.12)}.sp-test1234__so:focus-visible{outline:2px solid var(--sp-test1234-tb);outline-offset:2px}@media (hover:none){.sp-test1234__so{opacity:1;transform:none;pointer-events:auto}.sp-test1234__sos{position:static;padding-left:0;pointer-events:auto}}@media (prefers-reduced-motion:reduce){.sp-test1234 .sp-test1234__so,.sp-test1234:hover .sp-test1234__so,.sp-test1234:hover .sp-test1234__so:hover{transform:none;transition-property:opacity;transition-delay:0s}}.sp-test1234__so{position:relative}.sp-test1234__so::before{content:"";position:absolute;inset:-4px}.sp-test1234__stk{display:flex;flex:none}.sp-test1234__stk .sp-test1234__av{position:relative;box-shadow:0 0 0 2px var(--sp-test1234-bg)}.sp-test1234__stk .sp-test1234__av+.sp-test1234__av{margin-left:-9px}.sp-test1234__stk .sp-test1234__tm{color:#fff;font-size:10px;font-weight:600;line-height:1}.sp-test1234__stk .sp-test1234__tm:nth-child(2){background:#5b8def}.sp-test1234__stk .sp-test1234__tm:nth-child(3){background:#3bb273}.sp-test1234__stk .sp-test1234__av:nth-child(1){z-index:3}.sp-test1234__stk .sp-test1234__av:nth-child(2){z-index:2}@media (prefers-color-scheme:dark){.sp-test1234{--sp-test1234-bg:#14141c;--sp-test1234-bd:#2e2e3a;--sp-test1234-tn:#8a8a99;--sp-test1234-tb:#ffffff;--sp-test1234-ic:#8a8a99}}@media (prefers-reduced-motion:reduce){.sp-test1234__ic{transition:none}.sp-test1234,.sp-test1234 .sp-test1234__pill,.sp-test1234 .sp-test1234__pill:hover{animation:none;transform:none}.sp-test1234 .sp-test1234__pill::after{animation:none;opacity:0}.sp-test1234 .sp-test1234__pill:hover .sp-test1234__ic,.sp-test1234 .sp-test1234__pill:focus-visible .sp-test1234__ic{transform:none}}</style>
